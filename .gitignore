# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# 가상환경 — 아치가 다르면 깨진다. WSL(amd64)과 mac(arm64)을 오가므로 반드시 제외한다
.venv/
venv/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# 자격증명 — 이 저장소는 PUBLIC 이다. 어떤 형태로도 들어오면 안 된다.
# 토큰은 `~/.claude/keys/` 에 권한 600 으로 두고 환경변수로만 컨테이너에 넘긴다.
# 이 목록은 2차 방어일 뿐이며 1차는 `gate/secrets.py` 와 컨테이너 HOME 의 «자리»다 —
# 규칙으로만 두면 새는 날이 온다
.env
.env.*
keys/

# 컨테이너 안 claude 의 HOME 이 실수로 저장소 안에 잡혔을 때의 마지막 그물.
# 정상 경로는 저장소 «밖» 호스트 폴더다 (docker/run.sh)
.claude/projects/
.claude/.credentials.json

# 그날 밤의 실행 원자료 — [주의] 「일단 제외」이며 최종 결정이 아니다.
#
# 이 폴더에는 검색어·연 URL·판단 근거·세션 비용이 들어가고, 이 저장소는 PUBLIC 이다.
# 크기를 재고 포함 여부를 정하는 것은 Docker 단계의 일인데, 그때까지 미정인 채로 두면
# 그 사이 한 번의 커밋으로 전부 공개 이력에 박힌다. git 이력은 되돌아가지 않으므로
# 「되돌리기 쉬운 방향」을 기본값으로 잡았다 — 나중에 포함으로 «푸는» 것은 한 줄이다.
#
# 푸는 날에는 이 주석과 docs/DESIGN.md 를 함께 고친다
runs/

# 실행 로그
logs/
